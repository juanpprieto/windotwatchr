{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "windotwatchr": ["../../dist/index.d.ts"],
      "windotwatchr/react": ["../../dist/react/index.d.ts"]
    }
  },
  "include": ["src"]
}
