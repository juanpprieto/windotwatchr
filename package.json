{
  "name": "windotwatchr",
  "version": "0.1.0",
  "description": "Zero-polling, event-driven detection of window.* global properties and nested sub-APIs.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "oxlint": "^1.55.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "window",
    "DOM",
    "proxy",
    "observe",
    "third-party",
    "scripts",
    "global",
    "watcher"
  ],
  "author": "Juan P. Prieto",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}