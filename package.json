{
  "name": "windotwatchr",
  "version": "0.3.0",
  "description": "Readiness detection for window.* globals and nested APIs, using interception and optional polling.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/juanpprieto/windotwatchr.git"
  },
  "bugs": {
    "url": "https://github.com/juanpprieto/windotwatchr/issues"
  },
  "homepage": "https://github.com/juanpprieto/windotwatchr#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "bun --bun run oxlint --ignore-pattern next-env.d.ts",
    "test": "bun --bun run vitest run --project server-imports --project 'browser (chromium)' --project 'browser (firefox)'",
    "test:all": "bun --bun run vitest run",
    "test:consumers": "bun scripts/check-consumers.ts",
    "test:consumers:minimum": "bun scripts/check-consumers.ts --minimum",
    "test:watch": "bun --bun run vitest --project server-imports --project 'browser (chromium)' --project 'browser (firefox)'",
    "typecheck": "bun --bun run tsc --noEmit",
    "prepare": "husky",
    "check": "bun run typecheck && bun run lint && bun run test",
    "changeset": "bun ./node_modules/.bin/changeset",
    "version": "bun ./node_modules/.bin/changeset version",
    "test:e2e": "bun run --cwd e2e test",
    "build:examples": "bun run --cwd examples/vite-react build && bun run --cwd examples/nextjs build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --ignore-pattern next-env.d.ts"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "window",
    "proxy",
    "watcher",
    "observer",
    "sdk",
    "third-party",
    "react",
    "hook"
  ],
  "author": "Juan Prieto",
  "packageManager": "bun@1.4.2",
  "types": "./dist/index.d.ts",
  "trustedDependencies": [
    "esbuild"
  ],
  "workspaces": [
    ".",
    "examples/*",
    "e2e"
  ]
}
